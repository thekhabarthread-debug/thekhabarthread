rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "thekhabarthread@gmail.com"
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function validNews(data) {
      return data.keys().hasAll([
          "title", "category", "summary", "content", "image",
          "featured", "breaking", "date", "createdAt"
        ])
        && data.keys().hasOnly([
          "title", "category", "summary", "content", "image",
          "featured", "breaking", "date", "createdAt", "updatedAt",
          "publishedAt", "views"
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.summary is string && data.summary.size() <= 2000
        && data.content is string && data.content.size() <= 100000
        && data.image is string && data.image.matches('https://res[.]cloudinary[.]com/.*')
        && data.featured is bool
        && data.breaking is bool
        && data.date is string
        && data.createdAt is number
        && (!("updatedAt" in data) || data.updatedAt is number)
        && (!("publishedAt" in data) || data.publishedAt is string)
        && (!("views" in data) || data.views is number);
    }

    function validAd(data) {
      return data.keys().hasAll(["title", "image", "link", "position", "active", "createdAt"])
        && data.keys().hasOnly(["title", "image", "link", "position", "active", "createdAt"])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.image is string && data.image.matches('https://res[.]cloudinary[.]com/.*')
        && data.link is string && data.link.matches('https://.*')
        && data.position in ["homepage", "sidebar", "article"]
        && data.active is bool
        && data.createdAt is number;
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isAdmin() && validNews(request.resource.data);
      allow delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update: if isAdmin() && validAd(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
